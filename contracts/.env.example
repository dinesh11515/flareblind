DEPLOYER_KEY=

# Coston2 defaults (used when unset on --network coston2)
# BASE_TOKEN=0x0b6A3645c240605887a5532109323A3E12273dc7
# QUOTE_TOKEN=0xC1A5B41512496B80903D1f32d6dEa3a73212E71F
# FEED_ID=0x015852502f55534400000000000000000000000000

# Optional — register enclave at deploy time instead of engine/scripts/register.ts
# TEE_SIGNER=0x...
# ENCLAVE_PUBKEY=0x...
# ATTESTATION_DIGEST=0x...
